# Absolute path to the Obsidian vault where markdown reports are written.
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Absolute path to the folder the Excalidraw/Obsidian plugin auto-exports
# PNG/SVG diagrams into. "Attach latest diagram" reads the most recently
# modified file in this folder.
EXCALIDRAW_EXPORT_PATH=/path/to/excalidraw/export/folder

# API key for OpenRouter, used for all three model roles (interviewer,
# grader, question_sourcing).
OPENROUTER_API_KEY=sk-or-...
